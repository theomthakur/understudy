{
  "name": "understudy",
  "version": "0.1.0",
  "private": true,
  "description": "Computer-use automation: an LLM discovers a flow once, it becomes a typed capability, and it replays deterministically with no model in the loop.",
  "type": "module",
  "engines": { "node": ">=18.18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "target": "tsx target-app/server.ts",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay",
    "catalog": "tsx src/cli.ts catalog",
    "operator": "tsx src/cli.ts operator",
    "test": "node --import tsx --test tests/*.test.ts",
    "postinstall": "playwright install chromium --with-deps || playwright install chromium || true"
  },
  "dependencies": {
    "express": "^4.19.2",
    "playwright": "^1.47.0",
    "zod": "^3.23.8",
    "zod-to-json-schema": "^3.23.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
