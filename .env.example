# One of these is required for the DISCOVERY run only.
# Replay never calls a model, so replay works with no key at all.

# Anthropic (default provider)
ANTHROPIC_API_KEY=

# Or any OpenAI-compatible endpoint (OpenAI, Groq, OpenRouter, local)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional overrides
UNDERSTUDY_PROVIDER=anthropic      # anthropic | openai
UNDERSTUDY_MODEL=                  # defaults per provider
TARGET_PORT=4471
OPERATOR_PORT=4472
